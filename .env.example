# Tender Parser environment variables
# Copy to .env and adjust as needed.

APP_NAME=Tender Parser
DEBUG=false

# OCR — set if tesseract is not on PATH (Windows example):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANG=eng
OCR_DPI=300
TEXT_DENSITY_THRESHOLD=40
SCANNED_PAGE_RATIO=0.55

# AI Fix Agent — Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
