# Tender Parser environment variables
# Copy to .env and adjust as needed.

APP_NAME=Tender Parser
DEBUG=false

# OCR — set if tesseract is not on PATH (Windows example):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANG=eng
OCR_DPI=300
TEXT_DENSITY_THRESHOLD=40
SCANNED_PAGE_RATIO=0.55

# --- Online AI extraction (optional) ---
# There is no API key field in the app UI — configure it here only. Set
# AI_ENABLED=true, choose a provider, set the matching API key, then
# (re)start the app. The Streamlit sidebar will show it as already
# configured; there's nothing further to enter or save in the browser.
AI_ENABLED=false
AI_PROVIDER=none
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# AI_PROVIDER=gemini
# GEMINI_API_KEY=...          # New AI Studio keys start with AQ.; older keys use AIzaSy...
# GEMINI_MODEL=gemini-flash-latest
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# When AI is enabled, the whole document is split into page-group chunks and
# every chunk is sent to the model in turn (instead of only the first ~28k
# characters), so large tenders get fully read. Tune down for slower/cheaper
# models or smaller context windows, up for models with large context windows.
AI_CHUNK_MAX_PAGES=6
AI_CHUNK_MAX_CHARS=12000
